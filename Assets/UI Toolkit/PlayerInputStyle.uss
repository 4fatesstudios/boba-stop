.player-input-container {
    position: relative;
    bottom: auto;
    left: auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    flex-grow: 1;
    top: 150px;
}

.player-input-field {
    width: 300px;
    margin-bottom: 10px;
    font-size: 16px;
}

.submit-button {
    width: 100px;
    height: 40px;
    font-size: 16px;
    text-align: center;
}
