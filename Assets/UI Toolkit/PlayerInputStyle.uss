.player-input-container {
    width: 600px;
    height: 200px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    margin-left: auto;
    margin-right: auto;
    margin-top: 300px;
    border-radius: 20px;
}

.player-input-field {
    width: 400px;
    margin-bottom: 10px;
    font-size: 40px;
    height: 100px;
}

.button {
    width: 200px;
    height: 100px;
    font-size: 30px;
    text-align: center;
    background-image: url("project://database/Assets/Visuals/Placeholder/UI/InventorySlot.png?fileID=21300000&guid=59b9ffaff015c430b8bd282fe433b1cc&type=3#InventorySlot");
    -unity-font-definition: initial;
    -unity-font: url("project://database/Assets/Visuals/Fonts/elv-pixels-04.ttf?fileID=12800000&guid=6a01ae7b0dcb64d9da4347a4ef19f2cd&type=3#elv-pixels-04");
}
