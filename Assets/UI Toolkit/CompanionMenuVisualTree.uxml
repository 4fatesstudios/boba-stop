<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/CompanionMenuStyle.uss?fileID=7433441132597879392&amp;guid=afb30e8e9cf56478f9540a376823151b&amp;type=3#CompanionMenuStyle" />
    <ui:VisualElement name="Container" class="background-box">
        <ui:VisualElement name="MenuBackground" class="menu-background" style="flex-grow: 1; width: 487px; align-items: stretch; align-self: center; padding-bottom: 0; background-image: url(&quot;project://database/Assets/Visuals/Placeholder/UI/InventoryBackground.png?fileID=21300000&amp;guid=0da2a21d4c1c54e67bcf82b1835aa87f&amp;type=3#InventoryBackground&quot;); height: 0; min-width: 600px; min-height: 500px; max-width: 200px; max-height: 400px; justify-content: flex-start; flex-direction: column; margin-top: 269px;">
            <ui:Label tabindex="-1" text="Companions" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Title" style="-unity-text-align: upper-center; font-size: 100px; height: 56px; color: rgb(255, 255, 255); top: -14px; -unity-font: url(&quot;project://database/Assets/Visuals/Fonts/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=54868cb2b6793499e858360fd84827dd&amp;type=3#ThaleahFat_TTF&quot;); -unity-font-definition: initial;" />
            <ui:GroupBox name="ButtonContainer" style="justify-content: space-between; align-self: center; opacity: 1; align-items: stretch; flex-direction: row; margin-top: -27px; width: 551px;">
                <ui:Button text="Karen" parse-escape-sequences="true" display-tooltip-when-elided="true" name="KarenButton" class="button" />
                <ui:Button text="Aster" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AsterButton" class="button" />
                <ui:Button text="Kaden" parse-escape-sequences="true" display-tooltip-when-elided="true" name="KadenButton" class="button" />
                <ui:Button text="Jade" parse-escape-sequences="true" display-tooltip-when-elided="true" name="JadeButton" class="button" />
            </ui:GroupBox>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
