<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/DialogueBoxStyle.uss?fileID=7433441132597879392&amp;guid=07de55c21f77f46bfb06d98fd6286ae7&amp;type=3#DialogueBoxStyle" />
    <ui:VisualElement name="Container" style="flex-grow: 1;">
        <ui:VisualElement name="MainContent" style="flex-grow: 1; height: 70%;" />
        <ui:VisualElement name="DialogueContent" style="flex-grow: 1; flex-direction: row; align-items: center; background-image: url(&quot;project://database/Assets/Visuals/Placeholder/UI/InventoryBackground.png?fileID=21300000&amp;guid=0da2a21d4c1c54e67bcf82b1835aa87f&amp;type=3#InventoryBackground&quot;);">
            <ui:VisualElement name="PortraitContainer" style="flex-direction: column; align-items: center; margin-right: 20px;">
                <ui:Label name="SpeakerName" text="Speaker" style="font-size: 20px; margin-bottom: 10px; -unity-font-definition: initial; -unity-font: url(&quot;project://database/Assets/Visuals/Fonts/NeatpixelsMinimal.ttf?fileID=12800000&amp;guid=1d4c5fb3b32574c879b90f25c75167e6&amp;type=3#NeatpixelsMinimal&quot;);" />
                <ui:VisualElement name="DialoguePortrait" style="width: 150px; height: 150px; background-color: rgb(0, 0, 0);" />
            </ui:VisualElement>
            <ui:Label tabindex="-1" text="i loveeeeee yapping" parse-escape-sequences="true" display-tooltip-when-elided="true" name="DialogueText" style="flex-grow: 1; font-size: 35px; height: 250px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
