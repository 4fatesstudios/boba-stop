<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/InventoryMenuStyle.uss?fileID=7433441132597879392&amp;guid=226ae914af1fe4866b3774486a933e20&amp;type=3#InventoryMenuStyle" />
    <ui:VisualElement name="Container" style="flex-grow: 1; background-color: rgba(29, 29, 29, 0.82);">
        <ui:VisualElement name="Header" style="flex-grow: 1; flex-direction: row; height: 100px; max-height: 150px; min-height: 100px; padding-top: 10px; padding-right: 10px; border-bottom-color: rgb(151, 113, 74); border-left-width: 0; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-width: 1px;">
            <ui:Label tabindex="-1" text="INVENTORY" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Title" class="header_main" style="-unity-font-definition: initial; -unity-font: url(&quot;project://database/Assets/Visuals/Fonts/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=54868cb2b6793499e858360fd84827dd&amp;type=3#ThaleahFat_TTF&quot;); color: rgb(255, 255, 255); -unity-text-align: middle-left; width: auto;" />
            <ui:VisualElement name="Container_Currency" style="flex-grow: 1; flex-direction: row; align-items: center; justify-content: flex-end; padding-bottom: 10px; -unity-text-align: upper-left;">
                <ui:VisualElement name="Icon" style="flex-grow: 0; width: 60px; height: 60px; padding-right: 10px; background-image: url(&quot;project://database/Assets/LocalAssets/Coco%20Code%20Assets/Platform%20tile%20pack/ArtWork/Sprites/Tileset.png?fileID=3355423005436571770&amp;guid=1b39c0fe73f0433468e25eb21cfde7c2&amp;type=3#Tileset_37&quot;); padding-top: 0;" />
                <ui:Label tabindex="-1" text="420" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Value" class="header_main" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Body" style="flex-grow: 1; flex-direction: row-reverse; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-image: url(&quot;project://database/Assets/Visuals/Placeholder/UI/InventoryBackground.png?fileID=21300000&amp;guid=0da2a21d4c1c54e67bcf82b1835aa87f&amp;type=3#InventoryBackground&quot;);" />
    </ui:VisualElement>
</ui:UXML>
